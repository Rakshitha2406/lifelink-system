# LifeLink - Environment Configuration for MySQL Database

# Flask Settings
SECRET_KEY=lifelink-secret-key-emergency-matching-system-2026
FLASK_DEBUG=True
PORT=5000

# MySQL Database Configuration
# Configure these to match your local MySQL Server (e.g. XAMPP, WAMP, Docker, or MySQL Workbench)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=lifelink_db

# Engine mode: 'auto' tries MySQL first and falls back to SQLite if MySQL is offline.
# Set to 'mysql' to strictly require MySQL.
DB_MODE=auto
